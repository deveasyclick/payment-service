NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Runtime persistence; the parent directory is created automatically.
PAYMENT_DATA_FILE=./data/payments.json

# May be empty for local development; production will require a secret.
API_KEY=
TRUST_PROXY_HOPS=0

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MUTATION_RATE_LIMIT_WINDOW_MS=60000
MUTATION_RATE_LIMIT_MAX=20

WORKER_POLL_INTERVAL_MS=250
WORKER_ATTEMPT_TIMEOUT_MS=5000
WORKER_LEASE_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=250
WORKER_SHUTDOWN_TIMEOUT_MS=10000
SIMULATED_GATEWAY_LATENCY_MS=500
SIMULATED_GATEWAY_OUTCOME=succeeded
